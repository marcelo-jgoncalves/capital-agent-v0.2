{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PublicationPackage",
  "description": "Editorial handoff request prepared by the Capital Agent. Creation never implies publication authorization. See src/business_integration.py create_publication_package().",
  "type": "object",
  "required": ["publication_request_id", "content_brief_id", "experiment_id", "title", "draft_ref", "approval_required", "authorization_status", "created_at", "schema_version"],
  "properties": {
    "publication_request_id": {"type": "string"},
    "content_brief_id": {"type": "string"},
    "experiment_id": {"type": "string"},
    "title": {"type": "string"},
    "slug_suggestion": {"type": "string"},
    "draft_ref": {"type": "string"},
    "fact_check_ref": {"type": ["string", "null"]},
    "critic_ref": {"type": ["string", "null"]},
    "business_hypothesis_ref": {"type": ["string", "null"]},
    "cta_intent": {"type": ["string", "null"]},
    "attribution_tags": {"type": "array", "items": {"type": "string"}},
    "approval_required": {"type": "boolean", "const": true},
    "authorization_status": {"type": "string"},
    "created_at": {"type": "string"},
    "schema_version": {"type": "string"}
  },
  "additionalProperties": false
}
