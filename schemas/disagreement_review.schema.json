{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DisagreementReview",
  "type": "object",
  "required": ["question", "primary_conclusion", "second_conclusion", "common_facts",
               "disputed_assumptions", "human_intervention_required"],
  "properties": {
    "question": {"type": "string"},
    "primary_conclusion": {"type": "string"},
    "second_conclusion": {"type": "string"},
    "common_facts": {"type": "array", "items": {"type": "string"}},
    "disputed_assumptions": {"type": "array", "items": {"type": "string"}},
    "disputed_forecasts": {"type": "array", "items": {"type": "string"}},
    "missing_evidence": {"type": "array", "items": {"type": "string"}},
    "human_intervention_required": {"type": "boolean"}
  }
}
