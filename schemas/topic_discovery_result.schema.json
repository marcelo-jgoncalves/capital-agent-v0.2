{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TopicDiscoveryResult",
  "type": "object",
  "required": ["topic_id", "proposed_title", "core_problem", "target_reader", "origin", "confidence"],
  "properties": {
    "topic_id": {"type": "string"},
    "proposed_title": {"type": "string"},
    "core_problem": {"type": "string"},
    "target_reader": {"type": "string"},
    "search_or_demand_intent": {"type": "string"},
    "why_now": {"type": "string"},
    "commercial_relevance": {"type": "string"},
    "authority_fit": {"type": "string"},
    "lead_potential": {"type": "string"},
    "product_or_service_signal": {"type": "string"},
    "content_cluster": {"type": "string"},
    "estimated_competition": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "suggested_content_type": {"type": "string"},
    "suggested_call_to_action": {"type": "string"},
    "recommended_priority": {"type": "string"},
    "origin": {"type": "string", "enum": ["claude", "codex"]}
  }
}
