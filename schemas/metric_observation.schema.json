{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MetricObservation",
  "description": "Canonical experimental metric observation with mandatory provenance. See src/business_integration.py create_metric_observation() / filter_official_evaluation_observations().",
  "type": "object",
  "required": ["id", "experiment_id", "metric_name", "unit", "period", "source", "environment", "retrieved_at", "data_quality", "eligible_for_official_evaluation", "schema_version"],
  "properties": {
    "id": {"type": "string"},
    "experiment_id": {"type": "string"},
    "metric_name": {"type": "string"},
    "value": {"type": ["number", "null"]},
    "unit": {"type": "string"},
    "period": {"type": "string"},
    "source": {"type": "string"},
    "environment": {"type": "string", "enum": ["production", "dev", "test", "staging", "smoke", "e2e", "synthetic", "admin", "unknown"]},
    "retrieved_at": {"type": "string"},
    "coverage": {"type": ["string", "null"]},
    "data_quality": {"type": "string", "enum": ["observed", "aggregated", "manually_reported", "verified", "estimated", "unavailable"]},
    "limitations": {"type": ["string", "null"]},
    "eligible_for_official_evaluation": {"type": "boolean"},
    "schema_version": {"type": "string"}
  },
  "additionalProperties": false
}
