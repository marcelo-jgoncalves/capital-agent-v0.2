{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EditorialCriticResult",
  "type": "object",
  "required": ["verdict", "issues", "notes"],
  "properties": {
    "verdict": {"type": "string", "enum": ["ACCEPT", "REVISE", "RESEARCH_MORE", "REWRITE", "REJECT"]},
    "issues": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  }
}
